NODE_ENV=development
PORT=3000
APP_TIMEZONE=America/Caracas

# Neon: DATABASE_URL usa el host agrupado (-pooler) y DIRECT_URL el host directo (migraciones).
# Local (docker compose): ambos apuntan al contenedor.
DATABASE_URL=postgresql://view:view@localhost:5434/view_internet
DIRECT_URL=postgresql://view:view@localhost:5434/view_internet

# Base de datos para las pruebas e2e (se resetea en cada corrida).
TEST_DATABASE_URL=postgresql://view:view@localhost:5434/view_internet_test

JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=28800
AUTH_CACHE_TTL_MS=60000
BCRYPT_COST=12

LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_WINDOW_MS=900000
LOGIN_IP_LIMIT=30

# Almacenamiento S3 compatible (R2, Neon Object Storage, MinIO local).
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=receipts
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_FORCE_PATH_STYLE=true

# Semilla del primer administrador (prisma db seed).
SEED_ADMIN_CEDULA=V-12345678
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_PASSWORD=change-me-now-please

# Saltos de proxy de confianza (p. ej. 1 detrás del balanceador del hosting).
TRUST_PROXY=0
